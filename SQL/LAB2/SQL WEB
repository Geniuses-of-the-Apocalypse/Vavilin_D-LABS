-- === Таблица Оценок ===
CREATE TABLE Matks (
    idMarks INT PRIMARY KEY,
    Subject VARCHAR(50),
    Date_mark DATE,
    Mark INT,
    Student_idStudent INT,
    -- Создаем связь с таблицей Students
    FOREIGN KEY (Student_idStudent) REFERENCES Student(idStudent) 
    ON DELETE CASCADE
);

